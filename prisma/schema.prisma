generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(uuid()) @db.Uuid

  name         String?
  username     String? @unique
  email        String? @unique
  phone        String? @unique
  passwordHash String

  avatarUrl String?
  bio       String?

  city    String?
  state   String?
  country String?

  activities Activity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Sport {
  id   String  @id @default(uuid()) @db.Uuid
  name String
  slug String  @unique
  icon String?

  activities Activity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sports")
}

model Activity {
  id String @id @db.Uuid

  userId  String @db.Uuid
  sportId String @db.Uuid

  title       String?
  description String?

  startedAt  DateTime
  finishedAt DateTime

  totalDuration  Float
  activeDuration Float

  distance Float

  averagePace       Float
  averageActivePace Float

  averageSpeed Float
  maxSpeed     Float
  minSpeed     Float

  calories      Float
  elevationGain Float
  steps         Int

  mapSnapshotUrl String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  sport Sport @relation(fields: [sportId], references: [id])

  points ActivityPoint[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([sportId])
  @@index([userId, startedAt])
  @@map("activities")
}

model ActivityPoint {
  id String @id @default(uuid()) @db.Uuid

  activityId String @db.Uuid

  latitude  Float
  longitude Float

  altitude         Float?
  altitudeAccuracy Float?
  accuracy         Float

  speed   Float?
  heading Float?

  timestamp DateTime

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([activityId])
  @@index([activityId, timestamp])
  @@map("activity_points")
}
